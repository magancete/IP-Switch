<Project Sdk="Microsoft.NET.Sdk">
  <!--
    IP Switch unit tests (xUnit, .NET Framework 4.8).
    They cover the pure logic that needs no administrator rights and does not change the network:
    IP validation, generated netsh commands, hotkeys, command line, single-instance protocol, versions,
    profile validation and import/export.
    Run with: dotnet test
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IPSwitch\IPSwitch.csproj" />
  </ItemGroup>

</Project>
