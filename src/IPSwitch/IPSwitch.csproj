<Project Sdk="Microsoft.NET.Sdk">
  <!--
    IP Switch: IPv4 network profile manager for Windows.
    Distributed as a single portable IPSwitch.exe (~3 MB) on .NET Framework 4.8,
    which is preinstalled on Windows 10 (1903+) and Windows 11. See README.md and docs/ARCHITECTURE.md.
    Shared settings (target framework, language version, version number) live in Directory.Build.props.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>IPSwitch</RootNamespace>
    <AssemblyName>IPSwitch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>
    <Description>Portable network profile switcher for Windows</Description>

    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <!-- Costura resolves the embedded dependencies: no IPSwitch.exe.config is needed -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Mandatory XML documentation: the compiler warns (CS1591) about any undocumented public member -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <!-- Costura embeds every DLL in the .exe to ship a single portable file -->
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\favicon.ico" />
    <Resource Include="Resources\favicon.ico" />
  </ItemGroup>

</Project>
