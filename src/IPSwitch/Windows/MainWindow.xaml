<ui:FluentWindow x:Class="IPSwitch.Windows.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:pages="clr-namespace:IPSwitch.Pages"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Icon="pack://application:,,,/Resources/favicon.ico"
                 Title="IP Switch"
                 Width="960"
                 Height="640"
                 MinWidth="540"
                 MinHeight="420"
                 d:DesignHeight="680"
                 d:DesignWidth="1100"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d"
                 Closing="OnWindowClosing">
    <!--
        Main window: side navigation (Home, Profiles, Settings), pin and compact-view buttons in the title bar,
        notifications (SnackbarPresenter) and dialogs (ContentDialogHost).
        The tray icon and background services are handled in MainWindow.xaml.cs.

        Performance: NavigationCacheMode="Enabled" keeps each page alive after its first visit (pages are not
        recreated on every tab switch) and the page transition is a short fade.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView
            x:Name="NavigationView"
            Grid.Row="1"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            PaneDisplayMode="LeftFluent"
            Transition="FadeIn"
            TransitionDuration="150">

            <ui:NavigationView.Header>
                <StackPanel Margin="42,24,42,16">
                    <ui:BreadcrumbBar x:Name="BreadcrumbBar" />
                </StackPanel>
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav_Home}"
                    Icon="{ui:SymbolIcon Home24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav_Profiles}"
                    Icon="{ui:SymbolIcon NetworkAdapter16}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type pages:NetworkPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    NavigationCacheMode="Enabled"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="IP Switch"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{StaticResource AppIconSmallImage}" />
            </ui:TitleBar.Icon>
            <!-- Pin and compact view, next to minimize/maximize/close (Segoe Fluent glyphs E718 and EE49) -->
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource TitleBarGlyphButton}"
                                  Content="&#xE718;"
                                  ToolTip="{DynamicResource Set_AlwaysOnTop}"
                                  Click="OnPinClick" />
                    <Button x:Name="CompactButton"
                            Style="{StaticResource TitleBarGlyphButton}"
                            Content="&#xEE49;"
                            ToolTip="{DynamicResource Compact_Enter}"
                            Click="OnCompactClick" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
