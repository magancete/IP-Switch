<Page x:Class="IPSwitch.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Settings"
      mc:Ignorable="d">
    <!--
        Settings page. Every control saves immediately to AppSettings (App.Settings) when it changes.
        Sections: Appearance, Profiles page, Connection check, System and behavior, About.
    -->

    <StackPanel Margin="0,0,0,24">

        <!-- Appearance -->
        <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{DynamicResource Set_Appearance}" />

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_Theme}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_ThemeDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="ThemeComboBox" MinWidth="200" SelectionChanged="OnSettingChanged">
                <ComboBoxItem Tag="Light" Content="{DynamicResource Theme_Light}" />
                <ComboBoxItem Tag="Dark" Content="{DynamicResource Theme_Dark}" />
                <ComboBoxItem Tag="System" Content="{DynamicResource Theme_System}" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_Language}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_LanguageDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <!-- Language names are always shown in their own language -->
            <ComboBox x:Name="LanguageComboBox" MinWidth="200" SelectionChanged="OnSettingChanged">
                <ComboBoxItem Tag="en" Content="English" />
                <ComboBoxItem Tag="es" Content="Español" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Pin24}">
            <ui:CardControl.Header>
                <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_AlwaysOnTop}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ToggleAlwaysOnTop" Click="OnSettingChanged" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_CompactFade}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_CompactFadeDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ToggleCompactFade" Click="OnSettingChanged" />
        </ui:CardControl>

        <!-- Profiles page -->
        <ui:TextBlock Margin="0,28,0,8" FontTypography="BodyStrong" Text="{DynamicResource Set_NetworkPage}" />

        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon TableSettings24}" IsExpanded="True">
            <ui:CardExpander.Header>
                <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_VisibleColumns}" />
            </ui:CardExpander.Header>
            <UniformGrid Columns="3" Margin="40,0,0,0">
                <CheckBox x:Name="CheckSubnet" Content="{DynamicResource Col_Mask}" Margin="0,4" Click="OnSettingChanged"/>
                <CheckBox x:Name="CheckGateway" Content="{DynamicResource Col_Gateway}" Margin="0,4" Click="OnSettingChanged"/>
                <CheckBox x:Name="CheckInterface" Content="{DynamicResource Col_Interface}" Margin="0,4" Click="OnSettingChanged"/>
                <CheckBox x:Name="CheckPrimaryDNS" Content="{DynamicResource Col_Dns1}" Margin="0,4" Click="OnSettingChanged"/>
                <CheckBox x:Name="CheckSecondaryDNS" Content="{DynamicResource Col_Dns2}" Margin="0,4" Click="OnSettingChanged"/>
            </UniformGrid>
        </ui:CardExpander>

        <!-- Connection check -->
        <ui:TextBlock Margin="0,28,0,8" FontTypography="BodyStrong" Text="{DynamicResource Set_Verify}" />

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldCheckmark24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_VerifyEnabled}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="{DynamicResource Set_VerifyEnabledDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ToggleVerify" Click="OnSettingChanged" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_VerifyHost}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_VerifyHostDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="VerifyHostBox" MinWidth="200"
                        PlaceholderText="{DynamicResource Set_VerifyHostPlaceholder}"
                        LostFocus="OnSettingChanged" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
            <ui:CardControl.Header>
                <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_RevertTimeout}" />
            </ui:CardControl.Header>
            <ComboBox x:Name="RevertTimeoutComboBox" MinWidth="200" SelectionChanged="OnSettingChanged">
                <ComboBoxItem Tag="10" Content="10 s" />
                <ComboBoxItem Tag="15" Content="15 s" />
                <ComboBoxItem Tag="30" Content="30 s" />
                <ComboBoxItem Tag="60" Content="60 s" />
            </ComboBox>
        </ui:CardControl>

        <!-- System and behavior -->
        <ui:TextBlock Margin="0,28,0,8" FontTypography="BodyStrong" Text="{DynamicResource Set_Behavior}"/>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Rocket24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_Startup}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_StartupDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ToggleStartup" Click="OnStartupToggled" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CursorClick24}">
            <ui:CardControl.Header>
                <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_TrayClick}" />
            </ui:CardControl.Header>
            <ComboBox x:Name="TrayClickComboBox" MinWidth="200" SelectionChanged="OnSettingChanged">
                <ComboBoxItem Tag="flyout" Content="{DynamicResource Set_TrayClickFlyout}" />
                <ComboBoxItem Tag="window" Content="{DynamicResource Set_TrayClickWindow}" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowDown24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_MinimizeToTray}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_MinimizeToTrayDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ToggleMinimizeToTray" Click="OnSettingChanged" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon QuestionCircle24}">
            <ui:CardControl.Header>
                <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_ConfirmExit}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ToggleConfirmExit" Click="OnSettingChanged" />
        </ui:CardControl>

        <!-- About -->
        <ui:TextBlock Margin="0,28,0,8" Text="{DynamicResource Set_About}" FontTypography="BodyStrong"/>

        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_Updates}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  Text="{DynamicResource Set_UpdatesDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="CheckUpdatesButton" Content="{DynamicResource Set_CheckNow}" Margin="0,0,12,0"
                           Click="OnCheckUpdatesClick" />
                <ui:ToggleSwitch x:Name="ToggleUpdates" Click="OnSettingChanged" />
            </StackPanel>
        </ui:CardControl>

        <!-- Data folder: %AppData%\IPSwitch (or the IPSWITCH_DATA_DIR override) -->
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_DataFolder}" />
                    <ui:TextBlock x:Name="DataFolderText"
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                  TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                  Text="{DynamicResource Set_DataFolderDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="{DynamicResource Set_OpenFolder}"
                       Click="OnOpenDataFolderClick" />
        </ui:CardControl>

        <!-- Feedback: a single link to the GitHub issue chooser (bug, improvement, documentation, question) -->
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PersonFeedback24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="{DynamicResource Set_Feedback}" />
                    <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                  Text="{DynamicResource Set_FeedbackDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Icon="{ui:SymbolIcon Open24}" Content="{DynamicResource Set_FeedbackButton}"
                       Click="OnFeedbackClick" />
        </ui:CardControl>

        <ui:CardExpander ContentPadding="0">
            <ui:CardExpander.Icon>
                <ui:ImageIcon Source="{StaticResource AppIconSmallImage}" Width="24" Height="24"/>
            </ui:CardExpander.Icon>
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock FontTypography="Body" Text="IP Switch" />
                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                      Text="© 2026 carlosmagan.com | Carlos Magán" />
                    </StackPanel>
                    <ui:TextBlock x:Name="VersionText"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <ui:Anchor Padding="16"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Background="Transparent"
                           BorderThickness="0"
                           CornerRadius="0"
                           NavigateUri="https://github.com/magancete/IP-Switch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="{DynamicResource Set_Repository}" />
                        <ui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                    </Grid>
                </ui:Anchor>

                <ui:Anchor Padding="16"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Stretch"
                           Background="Transparent"
                           BorderThickness="0,1,0,0"
                           CornerRadius="0"
                           NavigateUri="https://carlosmagan.com">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="carlosmagan.com" />
                        <ui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                    </Grid>
                </ui:Anchor>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</Page>
