<Page x:Class="IPSwitch.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:IPSwitch.ViewModels"
      d:DataContext="{d:DesignInstance viewmodels:DashboardPageViewModel, IsDesignTimeCreatable=False}"
      Title="Dashboard"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <!--
        Home page: one card per adapter with its current IPv4 configuration and quick actions
        (save as profile, renew DHCP, restart, disable/enable, hide/show, WiFi networks).
        Adapters disabled in Windows are listed without IP data. Header with "Show hidden adapters (N)",
        "Flush DNS cache" and "Refresh".
    -->

    <Page.Resources>
        <Style x:Key="SelectableLabel" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Responsive header: if it does not fit on one line, the checkbox wraps below the buttons -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,12" FlowDirection="RightToLeft">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,0,0,8">
                <ui:Button Appearance="Secondary"
                           Icon="{ui:SymbolIcon Broom24}"
                           Content="{DynamicResource Dash_FlushDns}"
                           Click="OnFlushDnsClick"
                           Margin="0,0,8,0"/>
                <ui:Button Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Content="{DynamicResource Common_Refresh}"
                           Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <!-- "Show hidden adapters (N)": hidden adapters are stored in AppSettings.HiddenAdapters -->
            <CheckBox VerticalAlignment="Center" FlowDirection="LeftToRight" Margin="0,0,16,8"
                      IsChecked="{Binding ShowHidden}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Dash_ShowHidden}" />
                    <TextBlock Text="{Binding HiddenCount, StringFormat=' ({0})'}" />
                </StackPanel>
            </CheckBox>
        </WrapPanel>

        <!-- Empty state: no adapters, or all of them hidden -->
        <ui:Card Grid.Row="1" Padding="24" VerticalAlignment="Top"
                 Visibility="{Binding HasInterfaces, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="0,12,0,6" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Text="{DynamicResource Dash_NoAdapters}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding EmptyHint}" />
            </StackPanel>
        </ui:Card>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Interfaces}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <ui:Card.Style>
                            <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Card.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon FontSize="32"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,16,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Connector24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InterfaceType}" Value="WiFi">
                                                <Setter Property="Symbol" Value="Wifi124" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>

                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#33888888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                        <Setter Property="Background" Value="#3322AA55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12"/>
                                    </Border>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" Margin="0,0,6,0"
                                            VerticalAlignment="Center" Background="#33888888"
                                            Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Dash_HiddenBadge}" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Description}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>

                                <!-- IP data: enabled adapters only -->
                                <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Responsive: 3, 2 or 1 column depending on the available width -->
                                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource WidthToColumns}}">
                                    <StackPanel Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Dash_IPv4}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding IpAddress, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Dash_Mask}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SubnetMask, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Dash_Gateway}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Gateway, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Dash_Mode}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Mode, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Dash_Mac}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding MacAddress, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Dash_Speed}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Speed, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Separator Margin="0,8" Opacity="0.3"/>

                                <TextBlock Text="{DynamicResource Dash_Dns}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DnsServers, Mode=OneWay}" Style="{StaticResource SelectableLabel}"/>
                                </StackPanel>

                                <!-- Adapter actions -->
                                <!-- A single WrapPanel: buttons wrap to a new line when the window gets narrow -->
                                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                                    <!-- WiFi: opens the native Windows panel to search networks and connect -->
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8"
                                               Icon="{ui:SymbolIcon WifiSettings20}"
                                               Content="{DynamicResource Dash_WifiNetworks}"
                                               Click="OnWifiNetworksClick">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding InterfaceType}" Value="WiFi" />
                                                            <Condition Binding="{Binding IsEnabled}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <!-- Enabled adapter -->
                                    <ui:Button Appearance="Primary" Margin="0,0,8,8"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Content="{DynamicResource Dash_SaveAsProfile}"
                                               Click="OnSaveAsProfileClick"
                                               Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8"
                                               Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                               Content="{DynamicResource Dash_RenewDhcp}"
                                               Click="OnRenewDhcpClick"
                                               Visibility="{Binding IsDhcp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8"
                                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                                               Content="{DynamicResource Dash_Restart}"
                                               Click="OnRestartAdapterClick"
                                               Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ui:Button Appearance="Secondary" Margin="0,0,8,8"
                                               Icon="{ui:SymbolIcon PlugDisconnected24}"
                                               Content="{DynamicResource Dash_Disable}"
                                               Click="OnDisableAdapterClick"
                                               Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <!-- Disabled adapter -->
                                    <ui:Button Appearance="Primary" Margin="0,0,8,8"
                                               Icon="{ui:SymbolIcon PlugConnected24}"
                                               Content="{DynamicResource Dash_Enable}"
                                               Click="OnEnableAdapterClick"
                                               Visibility="{Binding IsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <!-- Hide / show -->
                                    <ui:Button Appearance="Secondary" Margin="0,0,0,8"
                                               Icon="{ui:SymbolIcon EyeOff24}"
                                               Content="{DynamicResource Dash_Hide}"
                                               Click="OnHideAdapterClick"
                                               Visibility="{Binding IsHidden, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <ui:Button Appearance="Secondary" Margin="0,0,0,8"
                                               Icon="{ui:SymbolIcon Eye24}"
                                               Content="{DynamicResource Dash_Unhide}"
                                               Click="OnUnhideAdapterClick"
                                               Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
