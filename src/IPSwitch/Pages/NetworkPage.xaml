<Page x:Class="IPSwitch.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="Profiles"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <!--
        Profiles page: search, add, import/export and the profile table.
        Each row allows applying (▶ or double click), editing and, from "More", duplicating,
        creating a desktop shortcut or deleting.
        Column headers are set in code because DataGridColumn does not support DynamicResource.
    -->

    <Page.Resources>
        <!-- "More" menu of each row. x:Shared=False: one instance per row -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="{DynamicResource Profiles_Duplicate}" Click="OnDuplicateClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Profiles_Shortcut}" Click="OnShortcutClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Link24" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Common_Delete}" Click="OnDeleteClick">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Page.Resources>

    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="SearchBox"
                        PlaceholderText="{DynamicResource Profiles_Search}"
                        Icon="{ui:SymbolIcon Search24}"
                        TextChanged="OnSearchChanged"
                        VerticalContentAlignment="Center"
                        ClearButtonEnabled="True"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}"
                           ToolTip="{DynamicResource Profiles_RefreshTip}"
                           Click="OnRefreshStatusClick"
                           Appearance="Secondary"
                           Padding="12,8"/>
                <ui:Button Icon="{ui:SymbolIcon ArrowUpload24}"
                           ToolTip="{DynamicResource Profiles_Import}"
                           Click="OnImportClick"
                           Appearance="Secondary"
                           Padding="12,8"
                           Margin="8,0,0,0"/>
                <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}"
                           ToolTip="{DynamicResource Profiles_Export}"
                           Click="OnExportClick"
                           Appearance="Secondary"
                           Padding="12,8"
                           Margin="8,0,0,0"/>
                <ui:Button Content="{DynamicResource Profiles_Add}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}"
                           Click="OnAddProfileClick"
                           Padding="16,8"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="4,0,0,12"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{DynamicResource Profiles_Hint}"/>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="2"
                   Margin="4,8,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{DynamicResource Profiles_Empty}"
                   Visibility="Collapsed"/>

        <ui:DataGrid x:Name="ProfilesDataGrid"
                     Grid.Row="2"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     HeadersVisibility="Column"
                     GridLinesVisibility="None"
                     CanUserResizeColumns="True"
                     CanUserReorderColumns="False"
                     HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AlternationCount="2"
                     RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                     AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                     MouseDoubleClick="OnRowDoubleClick"
                     SizeChanged="OnGridSizeChanged"
                     Sorting="OnSorting">

            <ui:DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                </Style>
            </ui:DataGrid.RowStyle>

            <ui:DataGrid.Columns>
                <!-- State: active, label color or invalid-profile warning -->
                <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding Color, Converter={StaticResource ColorBrush}}"
                                         Visibility="{Binding HasColor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                               Filled="True"
                                               Foreground="#FF3CC36B"
                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{DynamicResource Tip_Active}"/>
                                <ui:SymbolIcon Symbol="Warning24"
                                               Filled="True"
                                               Foreground="#FFE6A23C"
                                               ToolTip="{Binding ValidationMessage}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColName" Width="*" MinWidth="120" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <ui:SymbolIcon Symbol="Note24" FontSize="14" Margin="6,0,0,0"
                                               ToolTip="{Binding Notes}"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColIp" Binding="{Binding IPAddress}" Width="Auto" MinWidth="100" />
                <DataGridTextColumn x:Name="ColMask" Binding="{Binding SubnetMask}" Width="Auto" MinWidth="100" />
                <DataGridTextColumn x:Name="ColGateway" Binding="{Binding Gateway}" Width="Auto" MinWidth="100" />
                <DataGridTextColumn x:Name="ColDns1" Binding="{Binding PrimaryDNS}" Width="Auto" MinWidth="90" />
                <DataGridTextColumn x:Name="ColDns2" Binding="{Binding SecondaryDNS}" Width="Auto" MinWidth="90" />
                <DataGridTextColumn x:Name="ColInterface" Binding="{Binding Interface}" Width="Auto" MinWidth="90" />

                <DataGridTemplateColumn x:Name="ColActions" Width="Auto" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button Icon="{ui:SymbolIcon Play24}"
                                           Appearance="Primary"
                                           ToolTip="{DynamicResource Tip_Apply}"
                                           Click="OnApplyClick"
                                           IsEnabled="{Binding IsValid}"
                                           Margin="0,0,4,0"/>
                                <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                           Appearance="Secondary"
                                           ToolTip="{DynamicResource Tip_Edit}"
                                           Click="OnEditClick"
                                           Margin="0,0,4,0"/>
                                <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}"
                                           Appearance="Secondary"
                                           ToolTip="{DynamicResource Profiles_More}"
                                           Click="OnMoreClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
